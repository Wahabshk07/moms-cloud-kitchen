# Copy to .env and set a host your device can reach.
# Never put JWT secrets or DB credentials in EXPO_PUBLIC_* variables.

# iOS Simulator
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Android Emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Physical device (same Wi-Fi as the API host)
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
