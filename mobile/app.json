{
  "expo": {
    "name": "Mom's Cloud Kitchen",
    "slug": "moms-cloud-kitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "momscloudkitchen",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F5EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.yalaride.momscloudkitchen"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-full.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F9F5EA",
          "android": {
            "image": "./assets/images/brand-splash-crop.png",
            "imageWidth": 288,
            "resizeMode": "contain",
            "backgroundColor": "#F9F5EA"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mom's Cloud Kitchen to access your photos to upload menu images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": ""
    }
  }
}
